#include "esp_camera.h"
#include <vector>
#include <queue>

#define PWDN_GPIO_NUM  32
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM  0
#define SIOD_GPIO_NUM  26
#define SIOC_GPIO_NUM  27

#define Y9_GPIO_NUM    35
#define Y8_GPIO_NUM    34
#define Y7_GPIO_NUM    39
#define Y6_GPIO_NUM    36
#define Y5_GPIO_NUM    21
#define Y4_GPIO_NUM    19
#define Y3_GPIO_NUM    18
#define Y2_GPIO_NUM    5
#define VSYNC_GPIO_NUM 25
#define HREF_GPIO_NUM  23
#define PCLK_GPIO_NUM  22

// 4 for flash led or 33 for normal led
#define LED_GPIO_NUM   4

const int MIN_HOLE_SIZE = 20;
const int KERNEL_SIZE = 3;

int dx[] = {-1, 1, 0, 0};
int dy[] = {0, 0, -1, 1};

void setup() {
    Serial.begin(115200);
    if (!setupCamera()) {
        Serial.println("Camera setup failed");
        while (1);
    }
    Serial.println("Camera ready! Send 'C' to capture and process.");
}

void loop() {
    if (Serial.available()) {
        char cmd = Serial.read();
        if (cmd == 'C') {
            captureAndProcess();
        }
    }
}

bool setupCamera() {
    camera_config_t config;
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;
    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;
    config.pin_xclk = XCLK_GPIO_NUM;
    config.pin_pclk = PCLK_GPIO_NUM;
    config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM;
    config.pin_sscb_sda = SIOD_GPIO_NUM;
    config.pin_sscb_scl = SIOC_GPIO_NUM;
    config.pin_pwdn = PWDN_GPIO_NUM;
    config.pin_reset = RESET_GPIO_NUM;
    config.xclk_freq_hz = 20000000;
    config.pixel_format = PIXFORMAT_GRAYSCALE;
    config.frame_size = FRAMESIZE_QVGA;
    config.jpeg_quality = 12;
    config.fb_count = 1;

    esp_err_t err = esp_camera_init(&config);
    return err == ESP_OK;
}

void applyGaussianBlur(std::vector<std::vector<int>>& img, int width, int height) {
    std::vector<std::vector<int>> temp = img;
    for (int y = 1; y < height - 1; y++) {
        for (int x = 1; x < width - 1; x++) {
            int sum = 0;
            for (int ky = -1; ky <= 1; ky++) {
                for (int kx = -1; kx <= 1; kx++) {
                    sum += temp[y + ky][x + kx];
                }
            }
            img[y][x] = sum / 9;
        }
    }
}

void captureAndProcess() {
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
        Serial.println("Camera capture failed");
        return;
    }

    int width = fb->width;
    int height = fb->height;
    uint8_t *image = fb->buf;
    int avg = 0;
    for (int i = 0; i < width * height; i++) {
        avg += image[i];
    }
    int threshold = avg / (width * height);

    std::vector<std::vector<int>> binaryImg(height, std::vector<int>(width));
    for (int y = 0; y < height; y++) {
        for (int x = 0; x < width; x++) {
            int index = y * width + x;
            binaryImg[y][x] = (image[index] < threshold) ? 0 : 255;
        }
    }

    applyGaussianBlur(binaryImg, width, height);
    int holeCount = countHoles(binaryImg, width, height);
    Serial.print("Holes detected: ");
    Serial.println(holeCount);

    esp_camera_fb_return(fb);
}

int floodFill(std::vector<std::vector<int>>& image, int x, int y, int width, int height) {
    std::queue<std::pair<int, int>> q;
    q.push({x, y});
    image[y][x] = 255;
    int holeSize = 0;

    while (!q.empty()) {
        auto [cx, cy] = q.front();
        q.pop();
        holeSize++;

        for (int i = 0; i < 4; i++) {
            int nx = cx + dx[i];
            int ny = cy + dy[i];
            if (nx >= 0 && nx < width && ny >= 0 && ny < height && image[ny][nx] == 0) {
                image[ny][nx] = 255;
                q.push({nx, ny});
            }
        }
    }
    return (holeSize >= MIN_HOLE_SIZE) ? 1 : 0;
}

int countHoles(std::vector<std::vector<int>>& binaryImg, int width, int height) {
    int holeCount = 0;
    for (int y = 1; y < height - 1; y++) {
        for (int x = 1; x < width - 1; x++) {
            if (binaryImg[y][x] == 0) {
                holeCount += floodFill(binaryImg, x, y, width, height);
            }
        }
    }
    return holeCount;
}
